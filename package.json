{
  "name": "overlap-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet, browser-local workspace for finding time across time zones.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "benchmark": "node --experimental-strip-types scripts/benchmark.mjs",
    "check": "npm test && npm run build"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": { "typescript": "7.0.2", "vite": "8.3.0", "vitest": "5.0.0" }
}
